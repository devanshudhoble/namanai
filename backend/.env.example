# VoyAI / Naman AI Environment Configuration
# Provide these API keys when ready to switch from sandbox simulation to live production connectors.

# 1. LLM & Reasoning Engine
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# 2. Real-Time Telephony & Voice Audio
DEEPGRAM_API_KEY=your_deepgram_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# 3. Live Travel Inventory & GDS Integrations
AMADEUS_CLIENT_ID=your_amadeus_client_id_here
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret_here

# 4. Payments & Webhooks
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
UPI_MERCHANT_VPA=travelvoyai@hdfcbank

# 5. Database (PostgreSQL)
DATABASE_URL=postgresql://voyai_user:password@localhost:5432/voyai_db
