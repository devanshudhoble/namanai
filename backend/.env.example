# Copy to backend/.env (git-ignored). Keys are only ever read by the backend, never shipped to the browser.

# Gemini: language understanding (intent + slot extraction). Without it the app uses its offline rules engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_S=6

# Sarvam AI: Bulbul neural TTS (Indian English / Hindi). Without it the browser's built-in voice is used.
SARVAM_API_KEY=

PORT=8000
